---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Joey Henkel. All rights reserved.</p>
	<p><a href="https://github.com/joeyhenkel" target="_blank">GitHub</a> • <a href="https://linkedin.com/in/joeyhenkel" target="_blank">LinkedIn</a></p>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		background-color: var(--bg);
		margin-top: 4rem;
		padding: 2rem 1.5rem;
		text-align: center;
	}

	footer p {
		margin: 0.5rem 0;
		color: var(--text-light);
		font-size: 0.9rem;
	}

	footer a {
		color: var(--accent);
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	footer a:hover {
		opacity: 0.8;
	}
</style>
