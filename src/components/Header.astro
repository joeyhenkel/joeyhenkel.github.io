---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h1><a href="/">{SITE_TITLE}</a></h1>
		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/certifications">Certifications</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--border);
		background-color: var(--bg);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	nav {
		max-width: 768px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	h1 {
		margin: 0;
		font-size: 1.5rem;
	}

	h1 a {
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
	}

	h1 a:hover {
		color: var(--accent);
		text-decoration: none;
	}

	.nav-links {
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}

	.nav-links :global(a) {
		color: var(--text-light);
		text-decoration: none;
		transition: color 0.2s ease;
		font-weight: 500;
	}

	.nav-links :global(a:hover),
	.nav-links :global(a.active) {
		color: var(--accent);
	}

	@media (max-width: 640px) {
		nav {
			padding: 0.75rem 1rem;
			gap: 1rem;
		}

		h1 {
			font-size: 1.25rem;
		}

		.nav-links {
			gap: 1rem;
			font-size: 0.9rem;
		}
	}
</style>
